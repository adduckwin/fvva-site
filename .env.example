# ===========================================================================
# FVVA Site — Environment Variables
# Скопируй этот файл в .env и заполни значения
# ===========================================================================

# ---------------------------------------------------------------------------
# ОБЯЗАТЕЛЬНЫЕ ПЕРЕМЕННЫЕ
# ---------------------------------------------------------------------------

# Node environment (production / development)
NODE_ENV=production

# Порт сервера
PORT=3000

# URL базы данных MySQL/PostgreSQL
# Пример для MySQL: mysql://user:password@localhost:3306/fvva_db
# Пример для PostgreSQL: postgresql://user:password@localhost:5432/fvva_db
DATABASE_URL=

# Секретный ключ для подписи JWT-сессий (минимум 32 символа, случайная строка)
# Сгенерировать: openssl rand -base64 32
JWT_SECRET=

# ---------------------------------------------------------------------------
# ADMIN-ПАНЕЛЬ
# ---------------------------------------------------------------------------

# ID приложения (может быть любой строкой в standalone-режиме, например: fvva-prod)
VITE_APP_ID=fvva-prod

# OpenID владельца аккаунта (для standalone-режима можно указать любой уникальный ID)
# Это значение будет использоваться как идентификатор админа при первом входе
OWNER_OPEN_ID=admin

# ---------------------------------------------------------------------------
# ОПЦИОНАЛЬНЫЕ ПЕРЕМЕННЫЕ
# ---------------------------------------------------------------------------

# Manus OAuth Server URL (НЕ нужен для деплоя в России)
# Оставить пустым для standalone-режима (вход через логин/пароль напрямую)
OAUTH_SERVER_URL=

# Manus Forge API (для AI-функций чата, НЕ нужен если чат не используется)
# В standalone-режиме можно подключить OpenAI-совместимый API через прокси
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# AWS S3 (для хранения изображений, опционально)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET_NAME=

# ---------------------------------------------------------------------------
# ПРИМЕЧАНИЯ ДЛЯ ДЕПЛОЯ НА .RU ДОМЕНЕ
# ---------------------------------------------------------------------------
# 1. OAUTH_SERVER_URL оставить ПУСТЫМ - сервер работает в standalone-режиме
# 2. JWT_SECRET должен быть случайным (openssl rand -base64 32)
# 3. После первого запуска выполнить: pnpm db:push
# 4. Nginx должен проксировать запросы на PORT (3000)
# ---------------------------------------------------------------------------
